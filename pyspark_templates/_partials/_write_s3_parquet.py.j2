    logger.info(f"Writing to S3 path: {output_path}")
{% if write_mode == 'append' %}
{% if partition_columns %}
    df_transformed.write.mode("append").partitionBy({{ partition_columns }}).parquet(output_path)
{% else %}
    df_transformed.write.mode("append").parquet(output_path)
{% endif %}
{% else %}
{% if partition_columns %}
    df_transformed.write.mode("overwrite").partitionBy({{ partition_columns }}).parquet(output_path)
{% else %}
    df_transformed.write.mode("overwrite").parquet(output_path)
{% endif %}
{% endif %}

    logger.info(f"Write to S3 Parquet complete ({transformed_count} records)")